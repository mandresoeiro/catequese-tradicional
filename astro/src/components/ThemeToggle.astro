<button class="icon-button theme-toggle" type="button" aria-label="Ativar modo escuro" aria-pressed="false" title="Alternar tema">
  <svg class="moon-icon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"/></svg>
  <svg class="sun-icon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
</button>
<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
  const preference = window.matchMedia('(prefers-color-scheme: dark)');
  function syncButton() {
    const dark = document.documentElement.dataset.theme === 'dark';
    button.setAttribute('aria-pressed', String(dark));
    button.setAttribute('aria-label', dark ? 'Ativar modo claro' : 'Ativar modo escuro');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0e1726' : '#172a43');
  }
  syncButton();
  button.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('catequese-theme', theme); } catch { /* Tema funciona sem armazenamento. */ }
    syncButton();
  });
  preference.addEventListener('change', event => {
    try { if (localStorage.getItem('catequese-theme')) return; } catch { /* Usar preferência do sistema. */ }
    document.documentElement.dataset.theme = event.matches ? 'dark' : 'light'; syncButton();
  });
</script>
