---
import SiteLayout from '../layouts/SiteLayout.astro';
import { base, getLesson, getLessonSlugs } from '../lib/content';
const lessons = getLessonSlugs().map(getLesson);
---
<SiteLayout title="Visão geral">
  <section class="hero-panel" aria-labelledby="hero-title">
    <div class="eyebrow">Centro Dom Bosco · Catecismo de São Pio X</div>
    <h1 id="hero-title">Uma fé que ilumina.<br/>Uma tradição que forma.</h1>
    <p>Um espaço de estudo para aprender com profundidade, revisar com método e construir uma base sólida na doutrina católica.</p>
    <a class="action" href={base+'aulas/'}>Explorar minhas aulas <span aria-hidden="true">↗</span></a>
  </section>
  <p class="muted" id="progress-status" aria-live="polite">Seu progresso neste navegador será mostrado aqui.</p>
  <div class="resume-study" id="resume-study" hidden><strong>Continue de onde parou</strong><p id="resume-description"></p><a id="resume-link" class="action" href={base+'aulas/'}>Continuar estudo →</a></div>
  <div class="stat-grid" aria-label="Resumo do acervo">
    <div class="stat"><b>{String(lessons.length).padStart(2,'0')}</b><span>Aulas disponíveis</span></div>
    <div class="stat"><b>{String(lessons.length).padStart(2,'0')}</b><span>Questionários de revisão</span></div>
    <div class="stat"><b>01</b><span>Dicionário doutrinário</span></div>
  </div>
  <section class="section-heading" aria-label="Ferramentas de estudo"><div><span class="eyebrow">Memorização</span><h2>Revisar com flashcards</h2><p class="muted">Cartões de memorização para reforçar os pontos essenciais das aulas.</p><a class="action" href={base+'flashcards/'}>Abrir flashcards →</a></div></section>
  <div class="section-heading"><div><span class="eyebrow">Trilha de formação</span><h2>Aulas para continuar aprendendo</h2></div><a href={base+'aulas/'}>Ver todas →</a></div>
  <div class="cards">
    {lessons.map((l,i) => <a class="card" href={base+'aulas/'+l.slug+'/'}><span class="card-index">AULA {String(i+1).padStart(3,'0')}</span><strong>{l.title.replace(/^Aula #\d+\s*[—-]\s*/,'')}</strong><span class="card-arrow">Abrir aula ↗</span></a>)}
  </div>
  <script>
    const key='catequese:v2:concluidas';
    const node=document.querySelector('#progress-status');
    try {const items=JSON.parse(localStorage.getItem(key)||'[]');if(node)node.textContent='Meu progresso: '+(Array.isArray(items)?items.length:0)+' aulas concluídas neste navegador.';
      const slugs=Array.from(document.querySelectorAll<HTMLAnchorElement>('.cards a.card')).map(a=>new URL(a.href).pathname.split('/').filter(Boolean).at(-1)||'');
      const next=slugs.find(slug=>!items.includes(slug));
      const box=document.querySelector<HTMLElement>('#resume-study');
      const link=document.querySelector<HTMLAnchorElement>('#resume-link');
      const info=document.querySelector<HTMLElement>('#resume-description');
      if(box&&link&&info){box.hidden=false;info.textContent=next?'Próxima etapa: '+next.replace('aula-','Aula #'):'Todas as aulas estão marcadas como concluídas.';if(next)link.href=link.href+next+'/';}} catch {}
  </script>
</SiteLayout>
