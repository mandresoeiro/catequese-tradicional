---
import SiteLayout from '../layouts/SiteLayout.astro';
import { base, getLesson, getLessonSlugs } from '../lib/content';
const lessons = getLessonSlugs().map(getLesson);
---
<SiteLayout title="Início">
  <h1>Conhecer a fé. Guardar a Tradição.</h1>
  <p>Uma nova experiência para estudar o Catecismo de São Pio X, mantendo o acervo original.</p>
  <h2>Seu percurso de formação</h2>
  <div class="cards">{lessons.map((l) => <a class="card" href={base+'aulas/'+l.slug+'/'}><strong>{l.title}</strong><p>Estudar esta aula →</p></a>)}</div>
</SiteLayout>
