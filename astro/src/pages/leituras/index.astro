---
import SiteLayout from '../../layouts/SiteLayout.astro';
import {base} from '../../lib/content';
import {readFileSync} from 'node:fs';
import {resolve} from 'node:path';
import '../../styles/library.css';
import '../../styles/quiz.css';
interface Work{id:string;title:string;type:string;creator:string;level:string;length:string;language:string;description:string;context:string;reflection:string;url:string;linkLabel:string;lessons:string[];}
const works=JSON.parse(readFileSync(resolve(process.cwd(),'../library/media.json'),'utf8')) as Work[];
---
<SiteLayout title="Para ler e assistir"><span class="eyebrow">Aprofundar / Minha lista</span><h1>Para ler, ver e ouvir</h1><p class="muted">Uma seleção pequena, ligada às aulas. As fichas distinguem formação, espiritualidade e dramatização. Links consultados em 24/10/2026; disponibilidade, preços e edições podem mudar.</p><div class="library-filters"><label>Encontrar uma obra<input id="work-search" type="search" placeholder="Título, autor ou assunto…"/></label><label>Tipo<select id="work-type"><option value="">Todos</option>{[...new Set(works.map(work=>work.type))].map(type=><option>{type}</option>)}</select></label></div><p class="works-count" role="status">{works.length} indicações</p><div class="cards work-list">{works.map(work=><article class="work-card" data-work={work.id} data-work-type={work.type} data-work-search={work.title+' '+work.creator+' '+work.description}><span class="card-index">{work.type}</span><h2>{work.title}</h2><p>{work.creator}</p><dl><dt>Nível</dt><dd>{work.level}</dd><dt>Extensão</dt><dd>{work.length}</dd><dt>Idioma</dt><dd>{work.language}</dd></dl><p>{work.description}</p><details><summary>Contexto e reflexão</summary><p>{work.context}</p><p><b>Para pensar:</b> {work.reflection}</p></details><a href={work.url}>{work.linkLabel} ↗</a><div class="library-shortcuts">{work.lessons.map(slug=><a href={base+'aulas/'+slug+'/'}>{slug.replace('aula-','Aula ')}</a>)}</div><div class="work-status"><label for={'status-'+work.id}>Minha lista</label><select id={'status-'+work.id} data-reading-status><option value="want">Quero ler / ver / ouvir</option><option value="in_progress">Em andamento</option><option value="completed">Concluído</option></select><label for={'note-'+work.id} style="margin-top:12px">Minha anotação</label><textarea class="work-note" id={'note-'+work.id} maxlength="20000" placeholder="O que esta obra acrescentou ao estudo?"></textarea><button type="button" class="quiz-secondary" data-save-reading>Salvar na minha lista</button><p class="work-save-status" role="status"></p></div></article>)}</div></SiteLayout>
<script>
  import{studyRequest}from '../../lib/study-client';
  const cards=[...document.querySelectorAll<HTMLElement>('[data-work]')];
  studyRequest<{items:{work_id:string;status:string;note:string}[]}>('reading').then(data=>{data.items.forEach(item=>{const card=cards.find(card=>card.dataset.work===item.work_id);if(card){card.querySelector<HTMLSelectElement>('select')!.value=item.status;card.querySelector<HTMLTextAreaElement>('textarea')!.value=item.note;}});}).catch(()=>{});
  cards.forEach(card=>card.querySelector('[data-save-reading]')?.addEventListener('click',async()=>{const button=card.querySelector<HTMLButtonElement>('button')!;const notice=card.querySelector<HTMLElement>('.work-save-status')!;button.disabled=true;try{await studyRequest('reading',{work_id:card.dataset.work,status:card.querySelector<HTMLSelectElement>('select')!.value,note:card.querySelector<HTMLTextAreaElement>('textarea')!.value});notice.textContent='Salvo no banco pessoal.';}catch{notice.textContent='Não foi possível salvar. Abra a versão pessoal no computador; sua anotação continua aqui.';}finally{button.disabled=false;}}));
  const search=document.querySelector<HTMLInputElement>('#work-search')!,type=document.querySelector<HTMLSelectElement>('#work-type')!;const normalize=(text:string)=>text.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();function filter(){cards.forEach(card=>{card.hidden=!!((type.value&&card.dataset.workType!==type.value)||!normalize(card.dataset.workSearch!).includes(normalize(search.value)));});document.querySelector('.works-count')!.textContent=cards.filter(card=>!card.hidden).length+' indicações encontradas';}search.addEventListener('input',filter);type.addEventListener('change',filter);
</script>
